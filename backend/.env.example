# ─────────────────────────────────────────────────────────────────────────────
# Verdix Backend — Environment Configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Core server
PORT=5001
NODE_ENV=development

# Database (MongoDB Atlas connection string or local instance)
MONGODB_URI=mongodb://localhost:27017/verdix

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# CORS — comma-separated list of allowed origins (frontend URLs)
CORS_ORIGIN=http://localhost:3000

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── AI / RAG (xAI Grok, OpenAI-compatible) ──────────────────────────────────
# Required for case classification, RAG analysis, and embeddings.
XAI_API_KEY=
GROK_MODEL=grok-3-mini
EMBEDDING_MODEL=v1

# ── Indian Kanoon Crawler ───────────────────────────────────────────────────
# The crawler scrapes the public site — no API key required.
# Keep the delay polite to avoid overloading the source / being blocked.
KANOON_CRAWL_DELAY_MS=2500
KANOON_MAX_RETRIES=3
KANOON_TIMEOUT_MS=30000
KANOON_USER_AGENT=Mozilla/5.0 (compatible; VerdixLegalBot/1.0; +https://verdix.example/about/bot)

# ── Documents / uploads ─────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── Payments (optional) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
